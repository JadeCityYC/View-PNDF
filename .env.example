# Copy to `.env` (or export in your shell) and fill in your own values.
# NOTHING here is committed with real values -- `.env` is git-ignored.

# ---- Backbone --------------------------------------------------------------
# VIEWPNDF_MODEL_PATH=OpenGVLab/Mini-InternVL2-4B-DA-Medical

# ---- Datasets (point at your local copies) ---------------------------------
# IU_XRAY_ANNOTATION=/path/to/iu_xray/annotation.json
# IU_XRAY_IMAGE_ROOT=/path/to/iu_xray/images
# MIMIC_CXR_ANNOTATION=/path/to/mimic_cxr/annotation.json
# MIMIC_CXR_IMAGE_ROOT=/path/to/mimic_cxr/images

# ---- Output locations ------------------------------------------------------
# VIEWPNDF_NEURON_DIR=./neuron_deactivation
# VIEWPNDF_CKPT_DIR=./ckpt

# ---- LLM evaluator / integrator (OpenAI-compatible) ------------------------
# Required for evaluate_llm.py and integrate.py:
OPENAI_API_KEY=your-api-key-here
# Optional: Azure / self-hosted (e.g. local vLLM serving Qwen or DeepSeek):
# VIEWPNDF_LLM_BASE_URL=https://your-gateway/v1
# VIEWPNDF_JUDGE_MODEL=gpt-4o
# VIEWPNDF_INTEGRATOR_MODEL=gpt-4o
